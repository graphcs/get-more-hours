# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenRouter
OPENROUTER_API_KEY=sk-or-...

# Model used for document generation. Optional — defaults to
# anthropic/claude-haiku-4.5 ($1/$5 per M tokens, ~5s per document).
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Vision model used for OCR/text extraction from uploads. Optional — defaults
# to google/gemini-3.1-flash-lite, which is cheap and well suited to extraction.
OPENROUTER_OCR_MODEL=google/gemini-3.1-flash-lite

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin access — comma-separated emails that auto-upgrade to role='admin' on sign-in
ADMIN_EMAILS=admin@example.com

# Shared secret for the stale-job reaper cron (vercel.json -> crons).
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`. REQUIRED in
# production: /api/cron/reap-stale-jobs fails closed with 503 without it.
CRON_SECRET=generate-a-long-random-string
